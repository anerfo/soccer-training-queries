# Copy to .env and fill in. Never commit .env.
# Docker Compose reads this file automatically; for a manual venv run use
#   set -a; . ./.env; set +a
# before starting wa.py.

# Public base URL of your Authelia instance (must equal the issuer in
# https://<authelia>/.well-known/openid-configuration).
OIDC_ISSUER=https://auth.example.com

# OIDC client id/secret registered in Authelia. The secret here is the
# PLAINTEXT value; Authelia stores only its PBKDF2 digest.
OIDC_CLIENT_ID=whatsapp-agent
OIDC_CLIENT_SECRET=replace-with-plaintext-secret

# Must match the redirect_uris entry in Authelia exactly.
OIDC_REDIRECT_URI=http://192.168.178.98:8080/auth/callback

# Expected `aud` claim of bearer tokens (defaults to the client id).
OIDC_AUDIENCE=whatsapp-agent
OIDC_SCOPES="openid profile email groups"
# Must match token_endpoint_auth_method in Authelia:
# client_secret_basic (default) or client_secret_post.
OIDC_TOKEN_AUTH_METHOD=client_secret_basic

# Optional: provider logout page. Needed when the provider has no
# end_session_endpoint (Authelia uses https://<authelia>/logout).
# OIDC_LOGOUT_URL=https://auth.example.com/logout

# Signing key for the Flask session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Set to 1 only when the app is served over HTTPS.
# SESSION_COOKIE_SECURE=1

# Set to 1 to disable authentication entirely (local development only).
# AUTH_DISABLED=1
